{
  "manifestVersion": 1,
  "id": "app.tsuzuki.mangafire",
  "name": "MangaFire",
  "version": {
    "name": "0.1.2",
    "code": 3
  },
  "minHostApi": 1,
  "entrypoint": "main.js",
  "capabilities": [
    {
      "id": "reading.lookup",
      "version": 1
    },
    {
      "id": "reading.chapters",
      "version": 1
    },
    {
      "id": "reading.pages",
      "version": 1
    }
  ],
  "permissions": {
    "network": {
      "origins": [
        "https://mangafire.to",
        "https://*.mangafire.to",
        "https://mfcdn.cc",
        "https://*.mfcdn.cc",
        "https://mfcdn.nl",
        "https://*.mfcdn.nl",
        "https://mfcdn1.xyz",
        "https://*.mfcdn1.xyz",
        "https://mfcdn3.xyz",
        "https://*.mfcdn3.xyz"
      ],
      "localNetwork": false
    },
    "browser": {
      "origins": [
        "https://mangafire.to",
        "https://*.mangafire.to"
      ]
    },
    "storage": {
      "enabled": false
    },
    "secrets": []
  },
  "contentLanguages": [
    "en"
  ],
  "settings": []
}
