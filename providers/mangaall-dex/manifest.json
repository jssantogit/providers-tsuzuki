{
  "manifestVersion": 1,
  "id": "app.tsuzuki.mangaall.mangadex",
  "name": "MangaAll / MangaDex",
  "version": {
    "name": "0.1.0",
    "code": 1
  },
  "minHostApi": 1,
  "entrypoint": "main.js",
  "capabilities": [
    {
      "id": "reading.lookup",
      "version": 1
    },
    {
      "id": "reading.chapters",
      "version": 1
    }
  ],
  "permissions": {
    "network": {
      "origins": [
        "https://api.mangadex.org",
        "https://uploads.mangadex.org",
        "https://*.mangadex.network"
      ],
      "localNetwork": false
    },
    "browser": {
      "origins": []
    },
    "storage": {
      "enabled": false
    },
    "secrets": []
  },
  "contentLanguages": [
    "en",
    "pt-br"
  ],
  "settings": [],
  "publication": "metadata-only"
}
