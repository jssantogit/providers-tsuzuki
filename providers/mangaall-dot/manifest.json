{
  "manifestVersion": 1,
  "id": "app.tsuzuki.mangaall.mangadot",
  "name": "MangaAll / MangaDot",
  "version": {
    "name": "0.1.1",
    "code": 2
  },
  "minHostApi": 1,
  "entrypoint": "main.js",
  "capabilities": [
    {
      "id": "reading.lookup",
      "version": 1
    },
    {
      "id": "reading.chapters",
      "version": 1
    }
  ],
  "permissions": {
    "network": {
      "origins": [
        "https://mangadot.net"
      ],
      "localNetwork": false
    },
    "browser": {
      "origins": []
    },
    "storage": {
      "enabled": false
    },
    "secrets": []
  },
  "contentLanguages": [
    "en",
    "pt-br"
  ],
  "settings": [],
  "publication": "metadata-only"
}
